<Page x:Class="UIModels.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Product Details">

    <DockPanel Margin="16">

        <Button DockPanel.Dock="Top"
                Content="← Back"
                HorizontalAlignment="Left"
                Padding="8,4"
                Margin="0,0,0,16"
                Click="Back_Click"/>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="NameText"        FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock x:Name="CategoryText"    FontSize="14" Margin="0,2,0,0"/>
            <TextBlock x:Name="QuantityText"    FontSize="14" Margin="0,2,0,0"/>
            <TextBlock x:Name="PriceText"       FontSize="14" Margin="0,2,0,0"/>
            <TextBlock x:Name="TotalValueText"  FontSize="14" Margin="0,2,0,0"/>
            <TextBlock x:Name="DescriptionText" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

    </DockPanel>

</Page>
