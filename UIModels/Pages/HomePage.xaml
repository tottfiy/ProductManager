<Page x:Class="UIModels.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Warehouses">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Warehouses"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <ListBox x:Name="WarehousesList"
                 DisplayMemberPath="Name"
                 SelectionChanged="WarehousesList_SelectionChanged"
                 FontSize="14"/>

    </DockPanel>
</Page>
