<Page x:Class="UIModels.Pages.WarehouseDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Warehouse Details">

    <DockPanel Margin="16">

        <Button DockPanel.Dock="Top"
                Content="← Back"
                HorizontalAlignment="Left"
                Padding="8,4"
                Margin="0,0,0,12"
                Click="Back_Click"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="NameText"   FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="LocationText" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock x:Name="TotalValueText" FontSize="14" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Products:"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <ListBox x:Name="ProductsList"
                 DisplayMemberPath="Name"
                 SelectionChanged="ProductsList_SelectionChanged"
                 FontSize="14"/>

    </DockPanel>
</Page>
