<Application x:Class="UIModels.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:UIModels.ViewModels.Pages"
             xmlns:views="clr-namespace:UIModels.Views.Pages">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomePageViewModel}">
            <views:HomePageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:WarehouseDetailsPageViewModel}">
            <views:WarehouseDetailsPageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ProductDetailsPageViewModel}">
            <views:ProductDetailsPageView />
        </DataTemplate>
    </Application.Resources>
</Application>
