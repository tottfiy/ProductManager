<UserControl x:Class="UIModels.Views.Pages.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Warehouses"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <TextBlock DockPanel.Dock="Top"
                   Text="Оберіть склад зі списку, щоб переглянути детальну інформацію та товари."
                   Foreground="#FF555555"
                   Margin="0,0,0,16" />

        <ListBox ItemsSource="{Binding Warehouses}"
                 SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14"
                            Background="#FFF8F8F8"
                            CornerRadius="8"
                            BorderBrush="#FFE1E1E1"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LocationName, StringFormat=Локація: {0}}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding ProductCount, StringFormat=Товарів: {0}}" />

                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       Text="{Binding TotalValue, StringFormat=Загальна вартість: {0:C2}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
