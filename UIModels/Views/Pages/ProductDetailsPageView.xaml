<UserControl x:Class="UIModels.Views.Pages.ProductDetailsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Top"
                Content="← Back"
                HorizontalAlignment="Left"
                Padding="12,6"
                Margin="0,0,0,16"
                Command="{Binding BackCommand}" />

        <StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />
            <TextBlock Text="{Binding WarehouseName, StringFormat=Склад: {0}}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding CategoryName, StringFormat=Категорія: {0}}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Quantity, StringFormat=Кількість: {0}}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Price, StringFormat=Ціна за одиницю: {0:C2}}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding TotalValue, StringFormat=Загальна вартість: {0:C2}}" Margin="0,4,0,0" />
            <TextBlock Text="Опис:" FontWeight="SemiBold" Margin="0,16,0,4" />
            <Border Padding="12" Background="#FFF8F8F8" CornerRadius="8" BorderBrush="#FFE1E1E1" BorderThickness="1">
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
