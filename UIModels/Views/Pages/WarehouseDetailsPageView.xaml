<UserControl x:Class="UIModels.Views.Pages.WarehouseDetailsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Top"
                Content="← Back"
                HorizontalAlignment="Left"
                Padding="12,6"
                Margin="0,0,0,16"
                Command="{Binding BackCommand}" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding LocationName, StringFormat=Локація: {0}}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding TotalValue, StringFormat=Загальна вартість залишків: {0:C2}}" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Products"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ListBox ItemsSource="{Binding Products}"
                 SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Background="#FFF8F8F8"
                            CornerRadius="8"
                            BorderBrush="#FFE1E1E1"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CategoryName, StringFormat=Категорія: {0}}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding Quantity, StringFormat=Кількість: {0}}" />

                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding Price, StringFormat=Ціна: {0:C2}}" />

                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       Text="{Binding TotalValue, StringFormat=Вартість: {0:C2}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
